{
  "name": "restaurant-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:customer",
    "dev:customer": "vite --config apps/customer/vite.config.ts",
    "dev:admin": "vite --config apps/admin/vite.config.ts",
    "dev:kitchen": "vite --config apps/kitchen/vite.config.ts",
    "build": "tsc -b && vite build && npm run build:customer && npm run build:admin && npm run build:kitchen",
    "build:customer": "vite build --config apps/customer/vite.config.ts",
    "build:admin": "vite build --config apps/admin/vite.config.ts",
    "build:kitchen": "vite build --config apps/kitchen/vite.config.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:customer": "vite preview --outDir dist/customer",
    "preview:admin": "vite preview --outDir dist/admin --port 4174",
    "preview:kitchen": "vite preview --outDir dist/kitchen --port 4175"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
